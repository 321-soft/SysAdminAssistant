<Window x:Class="SysAdminAssistant.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="SysAdmin Assistant" Width="1440" Height="940" MinWidth="960" MinHeight="640" WindowStartupLocation="CenterScreen">
 <Grid><Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="224"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="{DynamicResource SaaThemeF8FAFF}" BorderBrush="{DynamicResource SaaThemeE1E8F3}" BorderThickness="0,0,1,0"><DockPanel Margin="12,18,12,12">
   <Grid DockPanel.Dock="Top" Margin="8,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="54"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Image Source="Assets/SaaLogo.png" Width="46" Height="46" Stretch="Uniform"/><TextBlock Grid.Column="1" Text="SysAdmin&#10;Assistant" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" Margin="9,0,0,0"/></Grid>
   <StackPanel DockPanel.Dock="Bottom"><Border BorderBrush="{DynamicResource SaaThemeE1E8F3}" BorderThickness="0,1,0,0" Margin="5,14,5,12"/><TextBlock x:Name="UserNameText" Text="Пользователь" FontWeight="SemiBold" Margin="12,0,0,4"/><TextBlock x:Name="UserRoleText" Text="" Foreground="{DynamicResource SaaTheme71829D}" FontSize="12" Margin="12,0,0,10"/><TextBlock x:Name="ClientVersionText" Text="Клиент" Foreground="{DynamicResource SaaTheme71829D}" FontSize="11" Margin="12,0,0,0"/></StackPanel>
   <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="Navigation" VerticalAlignment="Top"/></ScrollViewer>
  </DockPanel></Border>
  <Grid Grid.Column="1" Margin="16,16,16,10"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Margin="0,0,12,0"><TextBlock x:Name="PageTitle" FontSize="27" FontWeight="Bold" Text="Обзор"/><TextBlock x:Name="PageSubtitle" Foreground="{DynamicResource SaaTheme64748B}" Margin="0,5,0,0" Text="Вся инфраструктура под контролем" TextWrapping="Wrap"/></StackPanel>
    <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock x:Name="ConnectionBadge" Text="● Сервер доступен" Foreground="{DynamicResource SaaTheme16A34A}" FontSize="12" HorizontalAlignment="Right" Margin="0,0,8,8"/><WrapPanel HorizontalAlignment="Right"><Button x:Name="SearchButton" Content="Найти…" Padding="12,7"/><Button x:Name="WorkspaceFoldButton" MinWidth="150" Content="Свернуть сводку" Visibility="Collapsed" Click="WorkspaceFold_Click" Padding="12,7"/><Button x:Name="RefreshButton" MinWidth="120" Content="Обновить" Padding="12,7" MaxWidth="190"/></WrapPanel></StackPanel>
   </Grid>
   <Grid Grid.Row="1" x:Name="PageHost"/>
   <Border Grid.Row="2" BorderBrush="{DynamicResource SaaThemeE1E8F3}" BorderThickness="0,1,0,0" Margin="0,8,0,0" Padding="0,6,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="StatusLine" MaxHeight="42" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Foreground="{DynamicResource SaaTheme71829D}" TextWrapping="Wrap" Text="Запуск…" FontSize="12"/><Border x:Name="BusyIndicator" Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"><ProgressBar Width="90" Height="3" IsIndeterminate="True"/></Border></Grid></Border>
   <Grid Grid.Row="3" Margin="0,6,0,0" VerticalAlignment="Center">
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" MaxWidth="280"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <TextBlock x:Name="DeveloperCreditBlock" Margin="0,0,12,0" FontSize="11" Foreground="{DynamicResource SaaTheme71829D}" VerticalAlignment="Center" TextWrapping="Wrap"><Run x:Name="DeveloperCredit" Text="Бесплатная программа · Разработано "/><Hyperlink Click="DeveloperLink_Click">321.su</Hyperlink></TextBlock>
    <WrapPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
     <WrapPanel.Resources><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="FontSize" Value="11"/><Setter Property="MinHeight" Value="28"/><Setter Property="MinWidth" Value="0"/><Setter Property="Padding" Value="9,4"/><Setter Property="Margin" Value="6,2,0,2"/><Setter Property="VerticalAlignment" Value="Center"/></Style></WrapPanel.Resources>
     <Button Content="Справка · F1" Click="Help_Click"/><Button Content="RU / EN" Click="Language_Click"/><Button x:Name="ThemeButton" Content="☾" Click="Theme_Click"/><Button Content="Настроить рабочий стол" Click="Workspace_Click"/><Button x:Name="ProductUpdatesButton" AutomationProperties.Name="Обновления" Click="Updates_Click">
      <Grid>
       <TextBlock Text="Обновления" Margin="0,0,10,0"/>
       <Ellipse x:Name="ProductUpdatesDot" Width="7" Height="7" Fill="#16A34A"
                HorizontalAlignment="Right" VerticalAlignment="Top" Visibility="Hidden" IsHitTestVisible="False"/>
      </Grid>
     </Button><Button Content="Лицензионное соглашение" Click="Agreement_Click"/>
    </WrapPanel>
   </Grid>
  </Grid>
 </Grid></Window>